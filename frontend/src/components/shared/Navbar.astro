---
const navLinks = [
  { name: "Home", href: "/" },
  { name: "This Year", href: "/this-year" },
  { name: "Contestants", href: "/contestants" },
  { name: "Hall of Fame", href: "/hall-of-fame" },
  { name: "Gallery", href: "/gallery" },
  { name: "Team", href: "/team" },
  { name: "Organizers", href: "/organizers" },
  { name: "Sponsors", href: "/sponsors" },
];

const currentPath = Astro.url.pathname;
const isActive = (href: string) => href === "/" ? currentPath === "/" : currentPath.startsWith(href);

// Find the current page name for the mobile header
const currentPage = navLinks.find((l) => isActive(l.href));
const currentPageName = currentPage?.name ?? "Home";
---

<header class="sticky top-0 left-0 right-0 z-50 w-full bg-white border-b border-slate-200 shadow-xs">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <!-- Logo + brand -->
      <div class="flex items-center space-x-3">
        <img
          class="w-20 sm:w-28 md:w-36 lg:w-44 h-auto max-w-full"
          src="/pictures/TV-One-Logo-with-Sky.png"
          alt="TV One Logo"
        />
        <span class="hidden sm:inline-block text-xs font-semibold pl-3 border-l border-slate-300 text-slate-500">
          The Voice of Oneness
        </span>
      </div>

      <!-- Current page indicator (mobile only) -->
      <span class="md:hidden text-sm font-bold text-tvone-orange">
        {currentPageName}
      </span>

      <!-- Desktop nav -->
      <nav class="hidden md:flex items-center space-x-6 text-m font-semibold">
        {navLinks.map((link) => {
          const active = isActive(link.href);
          return (
            <a
              href={link.href}
              aria-current={active ? "page" : undefined}
              class={active
                ? "text-tvone-orange font-black underline underline-offset-8 decoration-2"
                : "text-slate-700 hover:text-blue-600 transition-colors duration-200"}
            >
              {link.name}
            </a>
          );
        })}
      </nav>

      <!-- Hamburger button (mobile only) -->
      <button
        id="mobile-menu-toggle"
        type="button"
        class="md:hidden inline-flex items-center justify-center p-2 rounded-lg text-slate-600 hover:text-slate-900 hover:bg-slate-100 transition-colors"
        aria-label="Open navigation menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <!-- Hamburger icon -->
        <svg id="hamburger-icon" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <!-- Close icon (hidden by default) -->
        <svg id="close-icon" class="w-6 h-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile dropdown menu (hidden by default) -->
  <nav
    id="mobile-menu"
    class="hidden md:hidden border-t border-slate-200 bg-white"
  >
    <div class="px-4 py-3 space-y-1">
      {navLinks.map((link) => {
        const active = isActive(link.href);
        return (
          <a
            href={link.href}
            aria-current={active ? "page" : undefined}
            class={`block px-3 py-2.5 rounded-lg text-sm font-semibold transition-colors ${
              active
                ? "bg-orange-50 text-tvone-orange font-black"
                : "text-slate-700 hover:bg-slate-50 hover:text-slate-900"
            }`}
          >
            {link.name}
          </a>
        );
      })}
    </div>
  </nav>
</header>

<script>
  function initMobileMenu() {
    const toggle = document.getElementById("mobile-menu-toggle");
    const menu = document.getElementById("mobile-menu");
    const hamburger = document.getElementById("hamburger-icon");
    const close = document.getElementById("close-icon");

    if (!toggle || !menu || !hamburger || !close) return;

    toggle.addEventListener("click", () => {
      const isOpen = !menu.classList.contains("hidden");
      menu.classList.toggle("hidden");
      hamburger.classList.toggle("hidden");
      close.classList.toggle("hidden");
      toggle.setAttribute("aria-expanded", String(!isOpen));
    });
  }

  // Run on initial load
  initMobileMenu();

  // Re-run after Astro view transitions
  document.addEventListener("astro:after-swap", initMobileMenu);
</script>
