---
import BaseLayout from '../../layouts/BaseLayout.astro';
import winners from '../../content/winners.json';

export async function getStaticPaths() {
  return winners.map((winner) => ({
    params: { slug: winner.slug },
    props: { winner },
  }));
}

const { winner } = Astro.props;

const positionLabels: Record<number, string> = { 1: '1st Place', 2: '2nd Place', 3: '3rd Place' };
const posLabel = positionLabels[winner.position as number] || `${winner.position}th Place`;

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": winner.name,
  "jobTitle": `${posLabel} - The Voice of Oneness (${winner.year})`,
  "award": `${posLabel} - The Voice of Oneness ${winner.year}`,
  "alumniOf": winner.location,
  "description": winner.quote
};
---

<BaseLayout
  title={`${winner.name} — Champion of ${winner.year} | The Voice of Oneness`}
  description={`Profile and recitation details for ${winner.name}, champion of The Voice of Oneness ${winner.year}.`}
  personSchema={personSchema}
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 space-y-8">
    <a href="/hall-of-fame" class="inline-flex items-center text-xs font-bold text-tvone-orange hover:text-tvone-blue transition-colors">
      &larr; Back to Hall of Fame
    </a>

    <!-- Detail Header: Gold Medallion + Champion Bio -->
    <div class="flex flex-col md:flex-row gap-10 items-center">
      <div class="relative shrink-0">
        <div class="w-52 h-52 rounded-full p-[4px] bg-[conic-gradient(from_180deg,#fde68a,#f59e0b,#fbbf24,#fde68a,#f59e0b,#fde68a)] shadow-[0_0_0_6px_rgba(251,191,36,0.15)]">
          <div class="w-full h-full rounded-full p-1 bg-white">
            <div class="w-full h-full rounded-full overflow-hidden bg-slate-100 flex items-center justify-center">
              {winner.photo ? (
                <img src={winner.photo} alt={winner.name} class="h-full w-full object-cover" loading="lazy" />
              ) : (
                <span class="text-slate-400 text-xs font-medium px-2">{winner.name}</span>
              )}
            </div>
          </div>
        </div>

        <div class="absolute -bottom-3 left-1/2 -translate-x-1/2 bg-gradient-to-r from-amber-500 to-orange-500 text-white text-xs font-extrabold px-4 py-1.5 rounded-full shadow-md whitespace-nowrap">
          {posLabel} — {winner.year}
        </div>
      </div>

      <div class="space-y-3 text-center md:text-left mt-4 md:mt-0">
        <h1 class="text-3xl font-extrabold text-slate-900">{winner.name}</h1>
        <p class="text-sm font-bold text-tvone-blue">
          {winner.category ? `${winner.category} • ` : ''}{winner.location}
        </p>

        <blockquote class="text-base italic text-slate-700 border-l-4 border-amber-400 pl-4 py-2 bg-amber-50/50 rounded-r text-left">
          &ldquo;{winner.quote}&rdquo;
        </blockquote>
      </div>
    </div>

    <!-- Details Section: Video Showcase & Season Badge -->
    <div class="mt-8 pt-8 border-t border-slate-200 grid grid-cols-1 md:grid-cols-3 gap-6 items-start">
      
      <!-- Video Player Column (Compact, takes 2 cols on desktop) -->
      <div class="md:col-span-2 bg-slate-50 p-4 rounded-xl border border-slate-200 space-y-3">
        <div class="flex items-center justify-between">
          <span class="text-xs text-slate-500 uppercase font-semibold tracking-wider">Final Stage Recitation</span>
          <span class="text-[11px] font-medium text-amber-700 bg-amber-100/70 border border-amber-200 px-2 py-0.5 rounded-full">
            Official Broadcast
          </span>
        </div>

        {winner.youtubeEmbedUrl ? (
          <div class="w-full max-w-md mx-auto aspect-video rounded-lg overflow-hidden shadow-sm bg-black">
            <iframe
              class="w-full h-full"
              src={winner.youtubeEmbedUrl}
              title={`${winner.name} - Final Recitation Challenge`}
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              allowfullscreen
              loading="lazy"
            ></iframe>
          </div>
        ) : (
          <div class="w-full max-w-md mx-auto aspect-video rounded-lg border border-dashed border-slate-300 bg-slate-100 flex flex-col items-center justify-center text-slate-400 space-y-1 p-4 text-center">
            <svg class="w-8 h-8 text-slate-300" fill="currentColor" viewBox="0 0 24 24">
              <path d="M10 15l5.19-3L10 9v6m11.56-7.83c.13.47.22 1.1.28 1.9.07.8.1 1.49.1 2.09L22 12c0 2.19-.16 3.8-.44 4.83-.25.9-.83 1.48-1.73 1.73-.47.13-1.33.22-2.65.28-1.3.07-2.49.1-3.59.1L12 22c-4.19 0-6.8-.16-7.83-.44-.9-.25-1.48-.83-1.73-1.73-.13-.47-.22-1.1-.28-1.9-.07-.8-.1-1.49-.1-2.09L2 12c0-2.19.16-3.8.44-4.83.25-.9.83-1.48 1.73-1.73.47-.13 1.33-.22 2.65-.28 1.3-.07 2.49-.1 3.59-.1L12 2c4.19 0 6.8.16 7.83.44.9.25 1.48.83 1.73 1.73z"/>
            </svg>
            <span class="text-xs font-medium">Broadcast footage coming soon</span>
          </div>
        )}
      </div>

      <!-- Broadcast Season Column (Takes 1 col on desktop) -->
      <div class="bg-slate-50 p-4 rounded-xl border border-slate-200">
        <span class="text-xs text-slate-500 uppercase font-semibold tracking-wider block">Broadcast Season</span>
        <span class="text-xl font-bold text-slate-900 mt-1 block">
          Season {winner.year - 2020}
        </span>
        <span class="text-xs text-slate-500 mt-0.5 block font-medium">
          Broadcast Year: {winner.year}
        </span>
      </div>

    </div>
  </div>
</BaseLayout>