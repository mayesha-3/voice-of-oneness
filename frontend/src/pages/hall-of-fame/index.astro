---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { HallOfFame } from '../../components/hall-of-fame/WinnerCard';
import winners from '../../content/winners.json';
---

<BaseLayout
  title="Hall of Fame & Past Winners | The Voice of Oneness"
  description="Honouring past champions of The Voice of Oneness national Qur'an recitation competition organized by TV One UK since 2021."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-10">
    <div class="text-center max-w-2xl mx-auto mb-[70px] mt-[20px]">
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900">Hall of Fame & Achievement Board</h1>
      <p class="text-slate-600 mt-2">Celebrating our national champions who demonstrated extraordinary recitation, Tajweed mastery, and devotion.</p>
    </div>

    <HallOfFame winners={winners} client:load />
  </div>
</BaseLayout>
