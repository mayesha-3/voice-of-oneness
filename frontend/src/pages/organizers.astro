---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Organizers & Vision | The Voice of Oneness"
  description="Learn about TV One UK, the organizing committee, and Chairman Moyeen Uddin Ahmed Chowdhury's vision for The Voice of Oneness."
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 space-y-10">
    <div class="text-center">
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900">Organizing Committee</h1>
      <p class="text-slate-600 mt-2">Driven by TV One UK to empower the next generation of Qur'an reciters.</p>
    </div>

    <div class="bg-white border border-slate-200 shadow-sm rounded-xl p-8 space-y-6">
      <div class="border-b border-slate-200 pb-6">
        <h2 class="text-2xl font-bold text-tvone-blue mb-2">TV One UK</h2>
        <p class="text-slate-700 leading-relaxed text-sm">
          TV One UK is a leading Islamic satellite television channel broadcasting across the UK and Europe. Established to serve the diverse Muslim community, TV One launched <strong>The Voice of Oneness</strong> in 2021 as its flagship national competition.
        </p>
      </div>

      <blockquote class="bg-slate-50 p-6 rounded-lg border-l-4 border-tvone-orange text-slate-800 italic space-y-2">
        <p class="text-base">
          "When we invest in our children’s relationship with the Qur’an, we invest in the future of our Ummah."
        </p>
        <footer class="text-xs font-bold text-tvone-blue not-italic">
          — Moyeen Uddin Ahmed Chowdhury, Chairman, TV One
        </footer>
      </blockquote>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-4">
        <div class="bg-slate-50 p-4 rounded-lg border border-slate-200">
          <h3 class="font-bold text-slate-900 text-sm mb-1">Production Team</h3>
          <p class="text-xs text-slate-600">TV One UK Broadcast Studios, London</p>
        </div>
        <div class="bg-slate-50 p-4 rounded-lg border border-slate-200">
          <h3 class="font-bold text-slate-900 text-sm mb-1">Academic Advisory Board</h3>
          <p class="text-xs text-slate-600">Senior Scholars & Tajweed Experts</p>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
